{
  "name": "SanalTrader Flutter Web Editor",
  "image": "mcr.microsoft.com/devcontainers/universal:2",
  "postCreateCommand": "bash scripts/codespaces_setup.sh",
  "forwardPorts": [3000],
  "portsAttributes": {
    "3000": {
      "label": "SanalTrader web preview",
      "onAutoForward": "openBrowser"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": ["Dart-Code.dart-code", "Dart-Code.flutter"]
    }
  }
}
